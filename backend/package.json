{
  "name": "company-inventory-sales-management-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write src test prisma/seed.ts prisma/production-demo-fixtures.ts prisma/seed-production-demo.ts prisma/create-initial-admin.ts prisma/initial-admin-diagnostics.ts prisma.config.ts \"*.json\" \"*.cjs\"",
    "format:check": "prettier --check src test prisma/seed.ts prisma/production-demo-fixtures.ts prisma/seed-production-demo.ts prisma/create-initial-admin.ts prisma/initial-admin-diagnostics.ts prisma.config.ts \"*.json\" \"*.cjs\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "admin:create-initial": "tsx prisma/create-initial-admin.ts",
    "db:seed:production-demo": "tsx prisma/seed-production-demo.ts",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
