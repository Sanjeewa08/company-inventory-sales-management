generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  STOREKEEPER
  SALES
  ACCOUNTANT
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  CANCEL
}

enum AlertType {
  LOW_STOCK
}

enum DocumentType {
  PURCHASE_ORDER
  INVOICE
  QUOTATION
  GOODS_RECEIPT
}

model User {
  id                     String          @id @default(uuid()) @db.Uuid
  name                   String
  email                  String          @unique
  passwordHash           String
  role                   UserRole
  branchId               String?         @db.Uuid
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  branch                 Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdPurchaseOrders  PurchaseOrder[] @relation("PurchaseOrderCreator")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprover")
  receivedGoods          GoodsReceipt[]  @relation("GoodsReceiptReceiver")
  createdQuotations      Quotation[]     @relation("QuotationCreator")
  createdInvoices        Invoice[]       @relation("InvoiceCreator")
  payments               Payment[]
  stockMovements         StockMovement[]
  auditLogs              AuditLog[]      @relation("AuditActor")
  alertsResolved         Alert[]         @relation("AlertResolver")

  @@index([branchId, role])
  @@index([isActive])
}

model Branch {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  stocks         Stock[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  quotations     Quotation[]
  invoices       Invoice[]
  alerts         Alert[]

  @@index([isActive])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive])
}

model Product {
  id             String              @id @default(uuid()) @db.Uuid
  sku            String              @unique
  name           String
  description    String?
  unit           String              @default("unit")
  categoryId     String              @db.Uuid
  costPrice      Decimal             @db.Decimal(12, 2)
  sellingPrice   Decimal             @db.Decimal(12, 2)
  reorderLevel   Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stocks         Stock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseOrderItem[]
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  alerts         Alert[]

  @@index([categoryId, isActive])
  @@index([name])
}

model Stock {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  branchId  String   @db.Uuid
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([productId, branchId])
  @@index([branchId, quantity])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid
  branchId      String            @db.Uuid
  userId        String?           @db.Uuid
  type          StockMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime          @default(now())
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, branchId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([userId])
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  contactName    String?
  email          String?         @unique
  phone          String?
  address        String?
  taxNumber      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  number        String              @unique
  supplierId    String              @db.Uuid
  branchId      String              @db.Uuid
  createdById   String              @db.Uuid
  approvedById  String?             @db.Uuid
  status        PurchaseOrderStatus @default(DRAFT)
  orderedAt     DateTime            @default(now())
  expectedAt    DateTime?
  approvedAt    DateTime?
  notes         String?
  subtotal      Decimal             @db.Decimal(12, 2)
  tax           Decimal             @default(0) @db.Decimal(12, 2)
  total         Decimal             @db.Decimal(12, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([branchId, status, orderedAt])
  @@index([supplierId, orderedAt])
  @@index([createdById])
  @@index([approvedById])
}

model PurchaseOrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  purchaseOrderId   String             @db.Uuid
  productId         String             @db.Uuid
  quantity          Int
  receivedQuantity  Int                @default(0)
  unitCost          Decimal            @db.Decimal(12, 2)
  lineTotal         Decimal            @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  number          String             @unique
  purchaseOrderId String             @db.Uuid
  branchId        String             @db.Uuid
  receivedById    String             @db.Uuid
  receivedAt      DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  receivedBy      User               @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([receivedById])
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid()) @db.Uuid
  goodsReceiptId      String            @db.Uuid
  purchaseOrderItemId String            @db.Uuid
  quantity            Int
  unitCost            Decimal           @db.Decimal(12, 2)
  createdAt           DateTime          @default(now())
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
}

model Customer {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  email      String?     @unique
  phone      String?
  address    String?
  taxNumber  String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  quotations Quotation[]
  invoices   Invoice[]

  @@index([name])
  @@index([isActive])
}

model Quotation {
  id          String          @id @default(uuid()) @db.Uuid
  number      String          @unique
  customerId  String          @db.Uuid
  branchId    String          @db.Uuid
  createdById String          @db.Uuid
  status      QuotationStatus @default(DRAFT)
  issuedAt    DateTime        @default(now())
  validUntil  DateTime?
  notes       String?
  subtotal    Decimal         @db.Decimal(12, 2)
  tax         Decimal         @default(0) @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       QuotationItem[]
  invoices    Invoice[]

  @@index([branchId, status, issuedAt])
  @@index([customerId, issuedAt])
  @@index([createdById])
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, productId])
  @@index([productId])
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  number      String        @unique
  customerId  String        @db.Uuid
  branchId    String        @db.Uuid
  quotationId String?       @unique @db.Uuid
  createdById String        @db.Uuid
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  notes       String?
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([branchId, status, issuedAt])
  @@index([customerId, issuedAt])
  @@index([createdById])
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, productId])
  @@index([productId])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  receivedById String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  receivedAt   DateTime      @default(now())
  notes        String?
  createdAt    DateTime      @default(now())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy   User          @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([invoiceId, receivedAt])
  @@index([receivedById, receivedAt])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime    @default(now())
  user      User?       @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([action, createdAt])
}

model Alert {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @db.Uuid
  productId    String    @db.Uuid
  type         AlertType @default(LOW_STOCK)
  message      String
  isRead       Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([branchId, productId, type])
  @@index([branchId, isRead, createdAt])
  @@index([resolvedById])
}

model DocumentSequence {
  id        String       @id @default(uuid()) @db.Uuid
  type      DocumentType
  year      Int
  nextValue Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([type, year])
}
